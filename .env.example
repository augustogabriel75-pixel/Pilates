# Banco de dados (SQLite local). Para PostgreSQL, troque o provider em prisma/schema.prisma.
DATABASE_URL="file:./cativar.db"

# Segredo para assinar os tokens JWT (mínimo 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-de-48-bytes"

# Cookies "Secure" (somente HTTPS). Padrão: true em produção. Use "false" para testar `next start` via http://localhost.
# COOKIE_SECURE="false"

# Cria pacientes, turmas e pagamentos de demonstração no seed (true/false).
SEED_DEMO="true"
